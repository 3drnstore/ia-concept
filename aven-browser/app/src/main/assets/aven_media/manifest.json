{
  "manifest_version": 2,
  "name": "Aven Media Detector",
  "version": "1.1.0",
  "description": "Detecta vídeos em reprodução para o downloader local do Aven.",
  "browser_specific_settings": {
    "gecko": {
      "id": "media-detector@aven.app"
    }
  },
  "permissions": [
    "<all_urls>",
    "webRequest",
    "nativeMessaging",
    "geckoViewAddons"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
